# ---------------------------------------------------------------------------
# PartScout environment configuration
# Copy to `.env` (never commit it) and fill in the providers you enable.
# Only the keys for the providers you actually enable are required.
# ---------------------------------------------------------------------------

# --- Core -------------------------------------------------------------------
# Public base URL, used for canonical URLs / OG metadata / sitemap.
NEXT_PUBLIC_APP_URL=http://localhost:3000
# Public product name (shown in the UI, OG metadata and the manifest).
NEXT_PUBLIC_APP_NAME=PartScout
# debug | info | warn | error  (default: info in development, warn in production)
LOG_LEVEL=info

# --- Database (PostgreSQL) --------------------------------------------------
# Application + research data (users, searches, research sessions, cache,
# feedback, usage). NOT an authoritative compatibility database.
# If this is unset/unreachable PartScout runs in "degraded mode": research
# still works, nothing is persisted. See README → Database setup.
DATABASE_URL=postgresql://partscout:partscout@localhost:5432/partscout?schema=public

# --- Auth -------------------------------------------------------------------
# 32+ char random string: `openssl rand -base64 48`
NEXTAUTH_SECRET=
AUTH_SECRET=
# Optional Google OAuth (only used when both values are present)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# --- Web search provider (REQUIRED for live research) -----------------------
# One of: tavily | exa | serper | brave | fixture
SEARCH_PROVIDER=tavily

TAVILY_API_KEY=
# Optional: tavily | basic | advanced  (advanced = more content, higher cost)
TAVILY_SEARCH_DEPTH=basic

EXA_API_KEY=
# Optional: keyword | neural | auto
EXA_SEARCH_MODE=auto
EXA_INCLUDE_TEXT=true

SERPER_API_KEY=
# Optional: google | bing ...
SERPER_SEARCH_ENGINE=google

BRAVE_SEARCH_API_KEY=
BRAVE_SEARCH_COUNTRY=us

# Optional secondary provider: results from both are merged when set.
SEARCH_FALLBACK_PROVIDER=

# --- AI reasoning provider (optional but recommended) ----------------------
# One of: openai | gemini | anthropic | none
# "none" runs the deterministic engine only (still real web research, no LLM).
AI_PROVIDER=gemini

GEMINI_API_KEY=
# Cheap/fast model for classification + extraction:
GEMINI_MODEL_FAST=gemini-3-flash
# Capable model for compatibility reasoning + final answer:
GEMINI_MODEL_SMART=gemini-3-pro

OPENAI_API_KEY=
OPENAI_MODEL_FAST=gpt-5-mini
OPENAI_MODEL_SMART=gpt-5

ANTHROPIC_API_KEY=
ANTHROPIC_MODEL_FAST=claude-haiku-4-5
ANTHROPIC_MODEL_SMART=claude-sonnet-4-5

# --- Optional override of the vision model used for part identification ----
VISION_MODEL=

# --- Cost control / limits --------------------------------------------------
MAX_QUERIES_PER_RESEARCH=6
MAX_RESULTS_PER_QUERY=8
MAX_PAGES_TO_FETCH=10
MAX_FETCH_BYTES=1500000
MAX_PAGE_TEXT_CHARS=14000
MAX_AI_INPUT_CHARS=24000
MAX_AI_OUTPUT_TOKENS=2000
RESEARCH_TIMEOUT_MS=75000
PAGE_FETCH_TIMEOUT_MS=9000
MAX_RESEARCHES_PER_HOUR_PER_IP=20
MAX_IDENTIFICATIONS_PER_HOUR_PER_IP=10
MAX_UPLOAD_BYTES=6000000

# --- Caching ----------------------------------------------------------------
RESEARCH_CACHE_TTL_MINUTES=720
SOURCE_CACHE_TTL_MINUTES=1440
SEARCH_CACHE_TTL_MINUTES=360
CACHE_ENABLED=true

# --- Admin ------------------------------------------------------------------
# Comma separated list of emails granted access to /admin
ADMIN_EMAILS=

# --- Fixtures (DEVELOPMENT ONLY) -------------------------------------------
# The fixture search provider returns synthetic pages so the UI and pipeline can
# be exercised without spending API credits. It is hard-disabled unless this is
# exactly "true" AND NODE_ENV != production. Results are always labelled
# "fixture data — not live research" in the UI.
PARTSCOUT_ALLOW_FIXTURES=false
